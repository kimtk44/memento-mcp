# Test fixture for `npm test`. NO SECRETS — this file is committed.
#
# Exists because several upstream unit tests assert library DEFAULTS
# (e.g. RERANKER_EXTERNAL_FALLBACK === "skip", embedding timeout/retries).
# Loading the production .env instead makes those tests fail on any
# deployment that legitimately overrides those knobs — which ours does.
# Keep this file free of the knobs under test so defaults apply.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=memento_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=test

REDIS_ENABLED=false
CACHE_ENABLED=false
MEMENTO_METRICS_DEFAULT=off
